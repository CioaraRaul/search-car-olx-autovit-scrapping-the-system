#!/bin/sh
# Blocks committing a real .env file (secrets). Template files like .env.example
# are allowed — only files named ".env" or ".env.<something>" that do NOT end in
# ".example" are blocked.

staged=$(git diff --cached --name-only --diff-filter=ACM)
blocked=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env(\.[A-Za-z0-9_-]+)?$' | grep -v '\.example$')

if [ -n "$blocked" ]; then
    echo "COMMIT BLOCKED — the following staged file(s) look like a real .env file:"
    echo "$blocked"
    echo ""
    echo "These commonly contain secrets (API keys, passwords, app tokens) and should"
    echo "never be committed. If you're certain this specific file is safe (e.g. a new"
    echo "template that should end in .example instead), fix the filename or run:"
    echo "  git reset HEAD -- <file>"
    echo "to unstage it. Only bypass this with --no-verify if you are certain."
    exit 1
fi

exit 0
