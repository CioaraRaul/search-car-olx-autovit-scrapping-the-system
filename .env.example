APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Car Finder"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reliability filter thresholds (all optional — sane defaults if unset, see config/car_knowledge.php)
# CAR_KNOWLEDGE_REJECT_BELOW_SCORE=90
# CAR_KNOWLEDGE_EXPECTED_KM_PER_YEAR=15000
# CAR_KNOWLEDGE_LOW_MILEAGE_RATIO=0.3
# CAR_KNOWLEDGE_LOW_MILEAGE_MIN_AGE=2
# CAR_KNOWLEDGE_LOW_MILEAGE_PENALTY=15
# CAR_KNOWLEDGE_PRICE_YEAR_RANGE=1
# CAR_KNOWLEDGE_PRICE_MIN_SAMPLE=5
# CAR_KNOWLEDGE_PRICE_RATIO_THRESHOLD=0.5
# CAR_KNOWLEDGE_PRICE_PENALTY=20
# CAR_KNOWLEDGE_DAMAGED_PENALTY=100
# CAR_KNOWLEDGE_HIGH_FUEL_CONSUMPTION_THRESHOLD=8.0
# CAR_KNOWLEDGE_HIGH_FUEL_CONSUMPTION_PENALTY=100
# CAR_KNOWLEDGE_NEW_SELLER_ACCOUNT_PENALTY=20

# BNR daily exchange rate feed, used to compute listings.price_eur (all optional, see config/exchange_rates.php)
# BNR_RATES_URL=https://curs.bnr.ro/nbrfxrates.xml
# BNR_RATES_CACHE_TTL=86400

# Who notify:send emails the listings digest to (see config/notifications.php)
NOTIFY_RECIPIENT_EMAIL=

# Scraper resilience: kill switches, backoff, circuit breaker (all optional — sane defaults if unset, see config/scraping.php)
# SCRAPE_AUTOVIT_ENABLED=true
# SCRAPE_OLX_ENABLED=true
# SCRAPER_CIRCUIT_BREAKER_THRESHOLD=3
# SCRAPER_CIRCUIT_BREAKER_COOLDOWN_MINUTES=60
# SCRAPER_BACKOFF_BASE_MS=1000
# SCRAPER_BACKOFF_MAX_MS=30000
# SCRAPER_BACKOFF_MAX_ATTEMPTS=4

# Safeguards on the Autovit detail-page fetch (one extra request per listing that survives the
# price filter, see AutovitDetailFetcher) — all optional, see config/scraping.php
# SCRAPER_AUTOVIT_DETAIL_DELAY_MIN_MS=3000
# SCRAPER_AUTOVIT_DETAIL_DELAY_MAX_MS=8000
# SCRAPER_AUTOVIT_DETAIL_DAILY_CAP=100

# Same safeguards for OLX's detail-page fetch (see OlxDetailFetcher) — all optional
# SCRAPER_OLX_DETAIL_DELAY_MIN_MS=3000
# SCRAPER_OLX_DETAIL_DELAY_MAX_MS=8000
# SCRAPER_OLX_DETAIL_DAILY_CAP=100

VITE_APP_NAME="${APP_NAME}"
